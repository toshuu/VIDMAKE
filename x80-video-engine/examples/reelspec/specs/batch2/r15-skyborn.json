{
  "id": "r15-skyborn",
  "canvas": { "w": 540, "h": 960, "fps": 30 },
  "system": "birth-sky",
  "concept": {
    "palette": { "bg": "#04060f", "ink": "#e8eefc", "accent": "#9db8ff", "accent2": "#ff8fb3", "pillBg": "#0d1428", "pillFg": "#9db8ff" },
    "faces": { "display": "Space Grotesk", "hero": "Space Grotesk", "kicker": "IBM Plex Mono" },
    "signature": "the whole sky wheels around one still star while a date burns in",
    "signatureWhy": "celestial-rotation strategy — anchored starfield spin, constellation draw, blinking invite"
  },
  "durations": [60, 60, 60],
  "transitions": [{ "type": "fade" }, { "type": "fade" }],
  "acts": [
    {
