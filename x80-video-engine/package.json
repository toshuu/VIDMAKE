{
  "name": "x80-video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "X80 Video Engine — deterministic, frame-based, browser-free short-form video compositor core",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "bench": "node benchmarks/run.mjs",
    "typecheck": "tsc -b --workspaces 2>/dev/null || tsc --noEmit -p packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.2"
  },
  "dependencies": {
    "@napi-rs/webcodecs-linux-x64-gnu": "^1.4.2"
  }
}
